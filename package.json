{
  "name": "boss-freeform",
  "version": "1.0.0",
  "description": "BossFreeForm — Standalone Apple Freeform styled Infinite Canvas Workspace for Windows with Google Drive & Google Account Sync",
  "main": "src/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/cirross2/BossFreeForm-.git"
  },
  "scripts": {
